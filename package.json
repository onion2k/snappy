{
  "name": "snappy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "mutate": "stryker run && npm run --silent mutate:judge",
    "mutate:judge": "esbuild scripts/mutation-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/mutation.mjs --log-level=warning && node node_modules/.cache/scripts/mutation.mjs",
    "mutate:update": "esbuild scripts/mutation-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/mutation.mjs --log-level=warning && node node_modules/.cache/scripts/mutation.mjs --update",
    "fuzz": "esbuild scripts/fuzz.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/fuzz.mjs --log-level=warning && node node_modules/.cache/scripts/fuzz.mjs",
    "determinism": "esbuild scripts/determinism-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/determinism.mjs --log-level=warning && node node_modules/.cache/scripts/determinism.mjs",
    "pace": "esbuild scripts/pace-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/pace.mjs --log-level=warning && node node_modules/.cache/scripts/pace.mjs",
    "pace:check": "esbuild scripts/pace-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/scripts/pace.mjs --log-level=warning && node node_modules/.cache/scripts/pace.mjs --check",
    "map": "esbuild scripts/map.ts --bundle --platform=node --format=esm --external:pngjs --outfile=node_modules/.cache/scripts/map.mjs --log-level=warning && node node_modules/.cache/scripts/map.mjs",
    "smoke": "playwright test",
    "look": "playwright test smoke/look.spec.ts",
    "look:update": "playwright test smoke/look.spec.ts --update-snapshots",
    "shots": "SHOTS=1 playwright test smoke/shots.spec.ts",
    "perf": "playwright test smoke/perf.spec.ts",
    "perf:update": "PERF_UPDATE=1 playwright test smoke/perf.spec.ts",
    "check:quick": "prettier --check . --log-level warn && npm run --silent typecheck && eslint . && vitest run --reporter dot",
    "check": "npm run --silent check:quick && npm run --silent fuzz && npm run --silent determinism && npm run --silent pace:check && npm run --silent mutate && npm run --silent smoke",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "artshape-physics": "github:onion2k/artshape-physics#v0.8.0",
    "artshape-render": "github:onion2k/artshape-render#v0.47.0",
    "artshape-sound": "github:onion2k/artshape-sound#v0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^22.20.2",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
